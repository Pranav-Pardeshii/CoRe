# --- Application & Logging ---
CORE_ENVIRONMENT=development
CORE_LOG_LEVEL=INFO

# --- CORS & Proxy Trust ---
# In production, list explicit frontend origin(s); '*' is rejected.
CORE_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
CORE_TRUSTED_PROXY_IPS=[]
# Set to 1 on Cloud Run behind Google Front End so X-Forwarded-For resolves per-client IPs
CORE_TRUSTED_PROXY_HOPS=0

# --- Database (Local TCP or Cloud SQL Unix Socket) ---
# Local TCP:
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=3306
# Cloud Run + Cloud SQL Unix socket (leave CORE_DB_HOST unset when using a socket):
# CORE_DB_UNIX_SOCKET=/cloudsql/your-project:your-region:your-instance
CORE_DB_USER=your-db-user
CORE_DB_PASS=your-db-password
CORE_DB_NAME=core
# Optional SSL CA path (relative to repo root or absolute; required if using TCP TLS)
# CORE_DB_SSL_CA=./ca.pem

# --- Async SQLAlchemy Pool & Timeouts (tuned for Cloud Run multi-instance scaling) ---
CORE_DB_POOL_SIZE=2
CORE_DB_MAX_OVERFLOW=3
CORE_DB_POOL_TIMEOUT=5
CORE_DB_CONNECT_TIMEOUT=5
CORE_DB_POOL_RECYCLE=1800

# --- Security & JWT ---
# Production requires >= 32 characters (store in Google Cloud Secret Manager)
CORE_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
CORE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate Limiting (process-local; pair with Cloud Armor for global edge limits) ---
CORE_AUTH_RATE_LIMIT_MAX_REQUESTS=20
CORE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORE_AUTH_LOGIN_USERNAME_MAX_ATTEMPTS=10
CORE_PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
CORE_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# --- Recommender ---
# Leave unset to dynamically query the latest 2 distinct admission years in MySQL,
# or pin explicitly e.g. CORE_RECOMMENDER_YEARS=[2024,2025]
# CORE_RECOMMENDER_YEARS=[2024,2025]
